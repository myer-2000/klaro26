{
  "name": "klaro26-apis",
  "private": true,
  "version": "0.1.0",
  "description": "Klaro26 \u2014 open-source, AI-native infrastructure APIs for agents.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:video": "tsx watch services/video/src/index.ts",
    "start:video": "tsx services/video/src/index.ts",
    "start:document": "tsx services/document/src/index.ts",
    "start:markdown": "tsx services/markdown/src/index.ts",
    "start:extract": "tsx services/extract/src/index.ts",
    "start:research": "tsx services/research/src/index.ts",
    "start:company": "tsx services/company/src/index.ts",
    "start:person": "tsx services/person/src/index.ts",
    "start:browse": "tsx services/browse/src/index.ts",
    "start:memory": "tsx services/memory/src/index.ts",
    "start:index": "tsx services/index/src/index.ts",
    "start:registry": "tsx services/registry/src/index.ts",
    "example": "tsx examples/quickstart.ts",
    "build:sdk": "npm -w @klaro26/sdk run build",
    "release:sdk": "npm -w @klaro26/sdk run build && npm -w @klaro26/sdk publish --access public",
    "release:python": "cd sdks/python && rm -rf dist && python -m build && twine upload dist/*",
    "demo": "tsx scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0"
  }
}
